# MoviePilot Go 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ==================== 应用配置 ====================
GIN_MODE=debug
SERVER_PORT=3001
LOG_LEVEL=debug

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moviepilot
DB_USER=moviepilot
DB_PASSWORD=moviepilot123
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# ==================== Redis配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ==================== 安全配置 ====================
JWT_SECRET=your_jwt_secret_key_here
API_KEY=your_api_key_here

# ==================== 第三方服务 ====================
TMDB_API_KEY=

# ==================== 其他配置 ====================
TZ=Asia/Shanghai
