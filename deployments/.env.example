# MoviePilot Go 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ==================== 应用配置 ====================
# 应用版本
VERSION=latest

# 运行模式: debug, release
GIN_MODE=release

# 服务器端口
SERVER_PORT=3001

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ==================== 数据库配置 ====================
# PostgreSQL配置
DB_HOST=postgres
DB_PORT=5432
DB_NAME=moviepilot
DB_USER=moviepilot
DB_PASSWORD=your_strong_password_here

# 数据库连接池配置
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600

# ==================== Redis配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ==================== 安全配置 ====================
# JWT密钥（请使用强随机字符串）
JWT_SECRET=your_jwt_secret_key_here

# API密钥（用于服务间通信）
API_KEY=your_api_key_here

# 会话密钥
SESSION_SECRET=your_session_secret_here

# ==================== Python插件服务配置 ====================
GRPC_SERVER_PORT=5000
GO_SERVER_HOST=moviepilot-go
GO_SERVER_PORT=3001

# ==================== 第三方服务配置 ====================
# TMDB API Key
TMDB_API_KEY=your_tmdb_api_key

# Telegram Bot配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 微信通知配置
WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_AGENT_ID=

# ==================== 下载器配置 ====================
# qBittorrent配置
QB_HOST=http://qbittorrent:8080
QB_USERNAME=admin
QB_PASSWORD=adminadmin

# Transmission配置
TR_HOST=http://transmission:9091
TR_USERNAME=
TR_PASSWORD=

# ==================== 媒体服务器配置 ====================
# Plex配置
PLEX_HOST=http://plex:32400
PLEX_TOKEN=

# Emby配置
EMBY_HOST=http://emby:8096
EMBY_API_KEY=

# Jellyfin配置
JELLYFIN_HOST=http://jellyfin:8096
JELLYFIN_API_KEY=

# ==================== 监控配置 ====================
# Prometheus配置
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana配置
GRAFANA_ADMIN_PASSWORD=admin123

# ==================== 其他配置 ====================
# 时区
TZ=Asia/Shanghai

# 代理配置（可选）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# 存储路径
DATA_PATH=/app/data
LOG_PATH=/app/logs
CONFIG_PATH=/app/configs
